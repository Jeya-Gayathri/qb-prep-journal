def calculate_one_phase(nom, p, phase_info):
    wkg_mnt = phase_info[0]
    contri = phase_info[1]
    roi = phase_info[2]
    end_age = nom + wkg_mnt
    for i in range (0,phase_info[0]):
        year = nom //12
        month = nom % 12
        cb = p + (p * roi) + contri
        print('Age {:3d} month{:3d} you have ${:.2f}'.format(year,month,p))
        p = cb
        nom = nom + 1 
    return cb, end_age

def calculateRetirement(start_age, cb, wkg, rtd):

    end_age = start_age + wkg[0]
    total_contri,end_age = calculate_one_phase(start_age, cb, wkg)
    final_bal,dummy = calculate_one_phase(end_age, total_contri, rtd)
