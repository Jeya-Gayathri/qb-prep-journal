import math

class Point:
    def __init__(self, x=0, y=0):
        self.x = x
        self.y = y

    def __str__(self):
        return f"({self.x}, {self.y})"

    def __repr__(self):
        return f"Point({self.x}, {self.y})"

    def move(self, dx, dy):
        self.x += dx
        self.y += dy

    def distance_from(self, other_pt):
        dx = other_pt.x - self.x
        dy = other_pt.y - self.y
        return math.sqrt(dx**2 + dy**2)


if __name__ == '__main__':
    p1 = Point(0, 0)
    p2 = Point(3, 4)
    print(p1)
    print(repr(p2))
    print(p1.distance_from(p2))
    p1.move(1, 1)
    print(p1)
