# Question: Duke Python C1 - Course 2, Module 4 (Diving Deeper with Lists)
#           List Max - find and return the maximum value in a list
# Approach: Handle None/empty list first (return None). Otherwise initialize
#           Max to the first element, then loop from index 1 comparing each
#           element and updating Max when a larger value is found.
# Status:   Complete - 100%
# Note: listMax() is my own code. doTest() and main() are course-provided
#       test scaffolding, included as-is to run the assignment.

def listMax(list):
    if list is None or len(list) == 0:
        return None
    Max = list[0]
    for i in range (1,len(list)):
        if list[i] > Max:
            Max = list[i]
    return Max
    pass

