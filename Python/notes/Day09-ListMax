    if list == None:
        print('None) is ',end='')
        pass
    else:
        n = len(list)
        print('[',end='')
        for i in range(0, n):
            print('{}'.format(list[i]),end='')
            if i < n - 1:
                print(', ',end='')
                pass
            pass
        print(']) is ',end='')
        pass
    max = listMax(list)
    if max == None:
        print('None')
        pass
    else:
        print('{}'.format(max))
        pass
    pass

